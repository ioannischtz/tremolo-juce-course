# This plugin uses a JUCE-module-style unity build: the files under
# tremolo_plugin/ are #included into tremolo_plugin.cpp (or into each other)
# and are never compiled standalone. They therefore have no entry in
# compile_commands.json and intentionally contain no JUCE/STL includes of
# their own. Opening one directly makes clangd see undeclared symbols
# everywhere, so force-include the module header to reproduce the build.
If:
  PathMatch: '.*tremolo_plugin/.*\.(h|hpp|cpp)'
CompileFlags:
  Add:
    - '-include'
    - 'tremolo_plugin/tremolo_plugin.h'

---
# The assets header is generated by juce_add_binary_data and included by the
# unity file just before the source/*.cpp files, so those files need it too.
# It does not exist until the project has been configured/built at least once.
If:
  PathMatch: '.*tremolo_plugin/source/.*\.cpp'
CompileFlags:
  Add:
    - '-include'
    - 'TremoloPluginAssets.h'
